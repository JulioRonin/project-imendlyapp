# Copia este archivo a .env.local para desarrollo. En producción, cárgalas en Vercel.
# NUNCA subas valores reales al repositorio.

# Supabase (públicas)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase: llave de servicio. SOLO servidor, jamás con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Tarea programada de pagos (Vercel la manda como "Authorization: Bearer ...")
CRON_SECRET=

# URL pública del sitio, para los enlaces de regreso de Stripe (opcional)
NEXT_PUBLIC_SITE_URL=
